{"src":"-- ROLLUP, CUBE, GROUPING SETS and GROUPING()\ncreate table gs (a text, b text, c int, v int);\ninsert into gs values ('x', 'p', 1, 10), ('x', 'p', 2, 20), ('x', 'q', 1, 30), ('y', 'p', 1, 40), ('y', null, 2, 50), (null, 'q', null, 60);\nselect a, b, sum(v) from gs group by rollup (a, b);\nselect a, b, sum(v) from gs group by rollup (a, b) order by a nulls last, b nulls last;\nselect a, b, sum(v), grouping(a), grouping(b), grouping(a, b) from gs group by rollup (a, b);\nselect a, b, sum(v), grouping(a, b) from gs group by cube (a, b);\nselect a, b, c, count(*) from gs group by cube (a, b, c);\nselect a, b, c, count(*), grouping(a, b, c) from gs group by rollup (a, b, c);\nselect a, b, sum(v) from gs group by grouping sets ((a), (b));\nselect a, b, sum(v) from gs group by grouping sets ((a, b), (a), ());\nselect a, sum(v) from gs group by grouping sets ((a), (a));\nselect a, sum(v) from gs group by grouping sets ((), ());\nselect sum(v) from gs group by grouping sets (());\nselect sum(v) from gs where false group by grouping sets (());\nselect sum(v), count(*) from gs where false group by rollup (a);\nselect a, sum(v) from gs where false group by cube (a);\nselect a, sum(v) from gs where false group by grouping sets ((a), ());\nselect a, b, sum(v) from gs group by a, rollup (b);\nselect a, b, c, sum(v) from gs group by a, cube (b, c);\nselect a, b, c, sum(v) from gs group by rollup (a), rollup (b);\nselect a, b, c, sum(v) from gs group by grouping sets (a, b), grouping sets (c, ());\nselect a, b, sum(v) from gs group by rollup ((a, b));\nselect a, b, c, sum(v) from gs group by rollup ((a, b), c);\nselect a, b, c, sum(v) from gs group by cube ((a, b), c);\nselect a, b, sum(v) from gs group by grouping sets (rollup (a, b), cube (b));\nselect a, b, sum(v) from gs group by grouping sets (a, rollup (b));\nselect a, b, sum(v) from gs group by distinct rollup (a, b), rollup (a);\nselect a, b, sum(v) from gs group by all rollup (a, b), rollup (a);\nselect a, b, sum(v) from gs group by rollup (a, b), rollup (a);\nselect a, sum(v) from gs group by rollup (a) having sum(v) > 50;\nselect a, sum(v) from gs group by rollup (a) having grouping(a) = 1;\nselect a, b, sum(v) from gs group by rollup (a, b) having grouping(b) = 0 and b is null;\nselect a, b, grouping(a) + grouping(b) * 10 from gs group by cube (a, b);\nselect case grouping(a) when 1 then 'all' else coalesce(a, 'none') end, sum(v) from gs group by rollup (a);\nselect coalesce(a, '-'), coalesce(b, '-'), sum(v) from gs group by rollup (a, b) order by grouping(a), grouping(b), 1, 2;\nselect a, sum(v) from gs group by rollup (a) order by grouping(a) desc, a;\nselect a, b, sum(v) from gs group by rollup (a, b) order by 1, 2;\nselect a, b, sum(v) from gs group by rollup (a, b) order by 1 nulls first, 2 nulls first, 3;\nselect grouping(a) from gs group by a;\nselect grouping(v) from gs group by a;\nselect a, grouping(a, a, a) from gs group by rollup (a);\nselect grouping(a) from gs;\nselect sum(grouping(a)) from gs group by a;\nselect a from gs where grouping(a) = 0 group by a;\nselect a, max(b), min(c) from gs group by rollup (a);\nselect a, count(distinct b), array_agg(v order by v) from gs group by rollup (a);\nselect a, string_agg(b, ',' order by b) from gs group by cube (a);\nselect a, b, sum(v) filter (where c = 1) from gs group by rollup (a, b);\nselect upper(a), sum(v) from gs group by rollup (upper(a));\nselect upper(a) as u, sum(v) from gs group by rollup (u);\nselect a, b, sum(v) from gs group by rollup (1, 2);\nselect a || b, sum(v) from gs group by rollup (a || b);\nselect a, b, sum(v) from gs group by grouping sets ((a, b), (b, a));\nselect a, sum(v), sum(sum(v)) over () from gs group by rollup (a);\nselect a, b, sum(v), rank() over (partition by grouping(a, b) order by sum(v) desc) from gs group by cube (a, b);\nselect * from (select a, b, sum(v) s from gs group by rollup (a, b)) t where a is null;\nselect count(*) from (select a, b, c from gs group by cube (a, b, c)) t;\nselect a, b from gs group by grouping sets ((a), (b)) having a is not null or b is not null;\nselect a, b, count(*) from gs group by grouping sets ((a), (b), (a, b)) having count(*) > 1;\nselect distinct a from gs group by rollup (a, b);\nselect a, c, sum(v) from gs group by grouping sets (a, c) order by c nulls first, a nulls first;\nselect a, b, c from gs group by grouping sets (a, b) ;\nselect company_id, city, sum(budget) from company group by cube (company_id, city) having count(*) > 1;\nselect city, company_id, count(*) from company group by rollup (city, company_id) having grouping(company_id) = 1;\nselect venue_code, stage_no, count(*), grouping(venue_code, stage_no) from performance group by cube (venue_code, stage_no);\nselect prod_id, venue_code, count(*) from performance where prod_id like 'PR1%' group by rollup (prod_id, venue_code);\nselect rating, count(*) from booking group by rollup (rating);\nselect company_id, count(*), avg(fee)::numeric(10,2) from artist group by rollup (company_id);\nselect pr.genre, pf.venue_code, count(*) from production pr join performance pf on pf.prod_id = pr.prod_id group by grouping sets ((pr.genre), (pf.venue_code), ());\nselect co.city, a.company_id, sum(a.fee) from artist a join company co using (company_id) group by rollup (co.city, a.company_id);\nselect city, points > 100, count(*) from patron group by cube (city, points > 100) having count(*) > 20;\nselect venue_code, stage_no, prod_id, count(*) from performance group by grouping sets ((venue_code, stage_no), (prod_id)) order by 1, 2, 3;\nselect x % 2, x % 3, sum(x) from generate_series(1, 12) x group by cube (x % 2, x % 3);\nselect x % 2 a, x % 3 b, grouping(x % 2), grouping(x % 3) from generate_series(1, 6) x group by rollup (x % 2, x % 3);\nselect grouping(x % 2) from generate_series(1, 6) x group by rollup (x % 3);\nselect a, b, sum(v) from gs group by grouping sets (a, b, ()) order by grouping(a), grouping(b), a, b;\nselect a, b, sum(v), grouping(b, a) 