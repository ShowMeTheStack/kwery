{"src":"-- results of the plans the optimizer chooses under different settings: every algorithm must give the same answers\ncreate table pa (k int, v text);\ncreate table pb (k int, w text);\ninsert into pa select g % 50, 'a' || g from generate_series(1, 400) g;\ninsert into pa values (null, 'anull'), (null, 'anull2');\ninsert into pb select g, 'b' || g from generate_series(40, 60) g;\ninsert into pb values (null, 'bnull');\nanalyze pa;\nanalyze pb;\nselect count(*), count(pa.k), count(pb.k) from pa join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa left join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa right join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa full join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pb left join pa on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pb right join pa on pa.k = pb.k;\nselect pb.k, count(pa.k) from pb left join pa on pa.k = pb.k group by pb.k order by pb.k nulls first;\nselect pa.k, pb.w from pa full join pb on pa.k = pb.k and pb.w <> 'b45' where pa.k is null or pb.k is null;\nselect count(*) from pa where exists (select 1 from pb where pb.k = pa.k);\nselect count(*) from pa where not exists (select 1 from pb where pb.k = pa.k);\nselect count(*) from pa where k in (select k from pb);\nset enable_hashjoin = off;\nselect count(*), count(pa.k), count(pb.k) from pa join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa left join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa right join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa full join pb on pa.k = pb.k;\nselect pa.k, pb.w from pa full join pb on pa.k = pb.k and pb.w <> 'b45' where pa.k is null or pb.k is null;\nselect pb.k, pb.w, pa.v from pb left join pa on pa.k = pb.k and pa.v like 'a4%' order by pb.k nulls first, pa.v;\nset enable_mergejoin = off;\nselect count(*), count(pa.k), count(pb.k) from pa join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa left join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa full join pb on pa.k = pb.k;\nset enable_nestloop = off;\nselect count(*), count(pa.k), count(pb.k) from pa join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa left join pb on pa.k = pb.k;\nselect count(*), count(pa.k), count(pb.k) from pa full join pb on pa.k = pb.k;\nselect a.person_id, c.name from artist a join company c using (company_id) order by a.person_id;\nselect count(*) from patron p join booking b on p.patron_id = b.patron_id join performance f on f.perf_id = b.perf_id;\nreset enable_hashjoin;\nreset enable_mergejoin;\nreset enable_nestloop;\n-- row equalities as join keys\nselect count(*) from pa join pb on (pa.k, pa.v) = (pb.k, 'a' || pb.k);\nselect pa.v, pb.w from pa join pb on (pa.k, pa.k + 1) = (pb.k, pb.k + 1) where pa.v < 'a10' order by 1, 2;\nselect pa.v, pb.w from pa left join pb on (pa.k, true) = (pb.k, pb.w > 'b5') where pa.k between 44 and 46 order by 1, 2;\nselect count(*) from pa full join pb on (pa.k, 1) = (pb.k, 1);\nselect count(*) from performance f join stage s on (f.venue_code, f.stage_no) = (s.venue_code, s.stage_no);\nselect count(*) from casting c join production p on (c.prod_id, true) = (p.prod_id, p.genre <> 'opera') and (c.lead, 1) = (true, 1);\nselect (1, null) = (1, 2), (1, null) = (2, 2), (1, 2) = (1, 2);\nselect count(*) from pa where (k, v) = (45, 'a45');\nselect count(*) from pa join pb on (pa.k, null::text) = (pb.k, pb.w);\n-- merge joins and group aggregates over sorted inputs\nset enable_hashjoin = off;\nset enable_nestloop = off;\nset enable_hashagg = off;\nselect p.city, count(*) from patron p join booking b on p.patron_id = b.patron_id group by p.city order by 1 nulls first;\nselect b.rating, count(*) from booking b group by b.rating;\nselect b.rating, count(*) from booking b group by b.rating order by b.rating nulls first;\nselect count(distinct b.patron_id), b.seats from booking b group by b.seats;\nselect m.mentee_id, a.billed_as from mentor m join artist a on a.person_id = m.mentor_id order by 1, 2;\nselect p.patron_id, b.perf_id from patron p left join booking b on p.patron_id = b.patron_id and b.rating = 5 where p.patron_id < 40 order by 1, 2;\nselect x, y from (values (1), (2), (2), (null)) a(x) full join (values (2), (null), (3)) b(y) on x = y order by x nulls first, y nulls first;\nselect x, y from (values (1), (2), (2), (null)) a(x) full join (values (2.0), (null), (3)) b(y) on x = y order by x nulls first, y nulls first;\nselect x, y from (values ('a'::char(3)), ('b')) a(x) join (values ('a  '::text), ('b')) b(y) on x = y;\nselect x, y from (values ('a'), ('b')) a(x) join (values ('a'), ('B')) b(y) on lower(x) = lower(y);\nselect company_id, sum(fee) from artist group by company_id having sum(fee) > 2000 order by 2, 1;\nreset all;\n-- index scans and index-only scans after an index exists\ncreate table pc (a int, b int, c text);\ninsert into pc select g, g % 7, 'c' || g from generate_series(1, 3000) g;\ncreate index pc_ab on pc (a, b);\nanalyze pc;\nselect b from pc where a = 77;\nselect a, b from pc where a between 100 and 105 order by a;\nselect count(*) from pc where a < 500;\nselect sum(b) from pc where a >= 2990;\nselect c from pc where a = 1234;\nselect a from pc where a = 3001;\nupdate pc set b = 99 where a = 10;\nselect a, b from pc where a = 10;\ndelete from pc where a = 11;\nselect count(*) from pc where a between 9 and 12;\ninsert into pc values (11, 5, 'again');\nselect a, b from pc where a = 11;\nbegin;\nupdate pc set b = 50 where a = 12;\nselect a, b from pc where a = 12;\nrollback;\nselect a, b from pc where a = 12;\nselect pc.a, pa.v from pc join pa on pa.k = pc.b where pc.a = 20 order by pa.v limit 3;\nselect count(*) from pc where (a, b) = (21, 0);\nset enable_seqscan = off;\nselect b from pc where a = 77;\nselect count(*) from pc where a < 500;\nselect a, b from pc where a > 2995 order by a desc;\nreset enable_seqscan;\ncreate index pc_c on pc (c) include (b);\nselect b from pc where c = 'c42';\nselect c, b from pc where c > 'c999' and c < 'c9991' order by c;\n-- comparison types decide hash and merge keys: char against text compares as text\nselect 'a'::char(3) = 'a  '::text, 'a'::char(3) = 'a  '::varchar, 'a'::char(3) = 'a '::char(5), 'a'::char(3) < 'a '::text, 'a'::char(3) = 'a';\nselect 'a'::char(3) in ('a  '::text), 'a'::char(3) in ('a  '::text, 'b'::text), 'a'::char(3) not in ('a  '::text), 1 in (null), 1 not in (2), null not in (1), 1 in ('1');\nselect 1 in ('a');\nselect x, y from (values ('a'::char(3)), ('b')) a(x) join (values ('a  '::text), ('b')) b(y) on x = y;\nset enable_hashjoin = off;\nselect x, y from (values ('a'::char(3)), ('b')) a(x) join (values ('a  '::text), ('b')) b(y) on x = y;\nselect x, y from (values ('a'::char(3)), ('b')) a(x) join (values ('a  '::varchar), ('b')) b(y) on x = y;\nreset enable_hashjoin;\n-- OR conditions answered by several indexes (a BitmapOr in Kwery), compared with PostgreSQL's rows\nreset all;\ncreate table bor (id int primary key, a int, b int, c text);\ninsert into bor select g, g % 300, g % 277, 'x' || g from generate_series(1, 3000) g;\ncreate index bor_a on bor (a);\ncreate index bor_b on bor (b);\nanalyze bor;\nset enable_seqscan = off;\nselect id from bor where a = 5 or b = 7 order by id;\nselect count(*), sum(id) from bor where a = 5 or b = 7 or a = 299;\nselect id from bor where (a = 5 and c = 'x5') or b = 7 or id = 2999 order by id;\nselect id from bor where (a = 1 or b = 2) and id > 1500 order by id;\nselect id from bor where a in (1, 2) or b between 10 and 11 order by id;\nselect id from bor where a = 5 or b is null order by id;\nselect count(*) from bor where a = 5 or a = 5;\nselect count(*) from bor where a < 0 or b < 0;\nupdate bor set b = 7 where id = 1;\nselect id from bor where a = 5 or b = 7 order by id;\ndelete from bor where a = 5;\nselect id from bor where a = 5 or b = 7 order by id;\nreset enable_seqscan;\nselect id from bor where a = 5 or b = 7 order by id;\n-- spilled sorts and hash joins give the same rows\nset enable_mergejoin = off;\nset enable_nestloop = off;\nselect count(*), count(distinct b.patron_id) from booking b join patron p on p.patron_id = b.patron_id;\nselect p.name, count(*) from booking b join patron p on p.patron_id = b.patron_id group by p.patron_id, p.name order by 2 desc, 1, p.patron_id limit 5;\nreset all;\nselect booking_id, perf_id, rating from booking order by rating nulls first, booking_id limit 7;\n-- a smallint column compared with integers uses its index (cross-type integer comparisons)\ncreate table ti (a smallint, b int, c bigint);\ninsert into ti select g % 5, g, g * 10 from generate_series(1, 2000) g;\ncreate index ti_a on ti (a);\ncreate index ti_c on ti (c);\nanalyze ti;\nset enable_seqscan = off;\nselect count(*) from ti where a = 3;\nselect count(*) from ti where a < 2;\nselect count(*) from ti where 2 <= a;\nselect count(*) from ti where a in (1, 2);\nselect count(*) from ti where a between 1 and 2;\nselect count(*) from ti where a = 3000000000;\nselect count(*) from ti where a < 3000000000;\nselect count(*) from ti where a > -3000000000;\nselect count(*) from ti where a = 3::bigint;\nselect count(*) from ti where c = 30;\nselect count(*) from ti where c = 30::smallint;\nselect count(*) from ti where c between 100::smallint and 200;\nselect count(*) from ti where a = 3.0;\nselect b from ti where a = 4 and b < 30 order by b;\ncreate index bk_seats on booking (seats);\ncreate index bk_rating on booking (rating);\nanalyze booking;\nselect count(*) from booking where seats = 2;\nselect count(*) from booking where rating >= 4;\nselect count(*) from booking where rating in (1, 5);\nselect count(*) from performance where stage_no = 1;\nreset enable_seqscan;\n-- operators above a join the optimizer reorders (the filter on the second table makes it the outer side)\ncreate table wr (id int primary key, k int);\ncreate table ws (k int primary key, tag text);\ninsert into wr select g, g % 50 from generate_series(1, 1000) g;\ninsert into ws select g, 't' || g from generate_series(0, 49) g;\nanalyze wr;\nanalyze ws;\nselect wr.id, count(*) over () from wr join ws on ws.k = wr.k where ws.tag = 't3';\nselect wr.id, ws.tag, row_number() over (order by wr.id desc) from wr join ws on ws.k = wr.k where ws.tag = 't7' order by 3;\nselect wr.id, sum(wr.id) over (partition by ws.tag order by wr.id rows 1 preceding) from wr join ws using (k) where ws.tag in ('t1', 't2') and wr.id < 200;\nselect wr.id, lag(ws.tag) over (order by wr.id) from ws join wr on ws.k = wr.k where ws.tag = 't9' and wr.id < 300;\nselect ws.tag, count(*), max(wr.id) from wr join ws on ws.k = wr.k where ws.tag like 't4%' group by ws.tag;\nselect distinct wr.k, ws.tag from wr join ws on ws.k = wr.k where ws.tag = 't5';\nselect wr.id, ws.tag from wr join ws on ws.k = wr.k where ws.tag = 't6' order by wr.id desc limit 4;\nselect wr.id, ws.tag from wr join ws on ws.k = wr.k where ws.tag = 't6' order by wr.id offset 5 fetch first 2 rows with ties;\nselect wr.id, generate_series(1, 2) from wr join ws on ws.k = wr.k where ws.tag = 't8' and wr.id < 120;\nselect wr.id, unnest(array[ws.tag, ws.tag || '!']) from wr join ws on ws.k = wr.k where ws.tag = 't8' and wr.id < 120;\nselect wr.id, ws.tag from wr join ws on ws.k = wr.k where ws.tag = 't2' order by wr.id limit 3 for update;\nselect count(*) over (), wr.id from wr join ws on ws.k = wr.k join wr w2 on w2.id = wr.id where ws.tag = 't3' and w2.k = 3;\nselect b.patron_id, count(*) over () from booking b join patron p on p.patron_id = b.patron_id where b.seats = 8;\nselect p.name, b.seats, rank() over (partition by p.city order by b.paid desc, b.booking_id) from booking b join patron p on p.patron_id = b.patron_id where b.seats >= 7;\nset enable_hashjoin = off;\nselect wr.id, count(*) over () from wr join ws on ws.k = wr.k where ws.tag = 't3';\nselect b.patron_id, count(*) over () from booking b join patron p on p.patron_id = b.patron_id where b.seats = 8;\nset enable_mergejoin = off;\nselect wr.id, count(*) over () from wr join ws on ws.k = wr.k where ws.tag = 't3';\nselect ws.tag, wr.id, dense_rank() over (order by wr.k) from ws join wr on ws.k = wr.k where ws.tag in ('t1', 't3') and wr.id < 160;\nset enable_nestloop = off;\nset enable_hashjoin = on;\nselect wr.id, count(*) over () from wr join ws on ws.k = wr.k where ws.tag = 't3';\nselect b.patron_id, count(*) over () from booking b join patron p on p.patron_id = b.patron_id where b.seats = 8;\nreset enable_hashjoin;\nreset enable_mergejoin;\nreset enable_nestloop;\n","data":"0861dad2ab981c12","out":[{"rows":[]},{"rows":[]},{"rows":[]},{"rows":[]},{"rows":[]},{"rows":[]},{"rows":[]},{"rows":[]},{"rows":["80\u001f80\u001f80"]},{"rows":["402\u001f400\u001f80"]},{"rows":["92\u001f80\u001f91"]},{"rows":["414\u001f400\u001f91"]},{"rows":["92\u001f80\u001f91"]},{"rows":["402\u001f400\u001f80"]},{"rows":["NULL\u001f0","40\u001f8","41\u001f8","42\u001f8","43\u001f8","44\u001f8","45\u001f8","46\u001f8","47\u001f8","48\u001f8","49\u001f8","50\u001f0","51\u001f0","52\u001f0","53\u001f0","54\u001f0","55\u001f0","56\u001f0","57\u001f0","58\u001f0","59\u001f0","60\u001f0"]},{"rows":["1\u001fNULL","2\u001fNULL","3\u001fNULL","4\u001fNULL","5\u001fNULL","6\u001fNULL","7\u001fNULL","8\u001fNULL","9\u001fNULL","10\u001fNULL","11\u001fNULL","12\u001fNULL","13\u001fNULL","14\u001fNULL","15\u001fNULL","16\u001fNULL","17\u001fNULL","18\u001fNULL","19\u001fNULL","20\u001fNULL","21\u001fNULL","22\u001fNULL","23\u001fNULL","24\u001fNULL","25\u001fNULL","26\u001fNULL","27\u001fNULL","28\u001fNULL","29\u001fNULL","30\u001fNULL","31\u001fNULL","32\u001fNULL","33\u001fNULL","34\u001fNULL","35\u001fNULL","36\u001fNULL","37\u001fNULL","38\u001fNULL","39\u001fNULL","45\u001fNULL","0\u001fNULL","1\u001fNULL","2\u001fNULL","3\u001fNULL","4\u001fNULL","5\u001fNULL","6\u001fNULL","7\u001fNULL","8\u001