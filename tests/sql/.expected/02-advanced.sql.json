{"src":"with recursive chain(prod_id, ancestor) as (select prod_id, based_on from production where based_on is not null union select chain.prod_id, production.based_on from chain, production where chain.ancestor = production.prod_id and production.based_on is not null) select * from chain order by 1, 2;\nwith recursive t(n) as (values (1) union all select n + 1 from t where n < 10) select sum(n) from t;\nwith recursive fib(a, b, n) as (select 0::numeric, 1::numeric, 1 union all select b, a + b, n + 1 from fib where n < 30) select a from fib order by n desc limit 1;\nwith recursive chain as (select prod_id, based_on, 1 as depth from production where based_on is not null and genre <> 'opera' union all select c.prod_id, p.based_on, c.depth + 1 from chain c join production p on c.based_on = p.prod_id where p.based_on is not null) select prod_id, max(depth) from chain group by prod_id order by 1;\nselect company_id, rank() over (order by budget desc) from company order by 2, 1;\nselect person_id, company_id, fee, rank() over (partition by company_id order by fee desc) as r from artist order by company_id, r, person_id;\nselect person_id, fee, sum(fee) over (order by fee, person_id rows between unbounded preceding and current row) from artist order by fee, person_id;\nselect person_id, fee, avg(fee) over w, max(fee) over w from artist window w as (partition by company_id) order by person_id;\nselect patron_id, dense_rank() over (order by points desc) from patron order by 2, 1 limit 20;\nselect company_id, ntile(3) over (order by budget, company_id) from company order by budget, company_id;\nselect person_id, lag(fee) over (order by fee, person_id), lead(fee, 2, 0) over (order by fee, person_id) from artist order by fee, person_id;\nselect patron_id, row_number() over (partition by city order by points desc, patron_id) from patron order by patron_id;\nselect prod_id, perf_date, count(*) over (partition by prod_id) from performance order by prod_id, perf_date, start_time, perf_id;\nselect company_id, sum(budget) over (order by company_id rows between 1 preceding and 1 following) from company order by company_id;\nselect first_value(person_id) over (partition by company_id order by fee, person_id), last_value(person_id) over (partition by company_id order by fee, person_id rows between unbounded preceding and unbounded following), company_id from artist order by company_id, fee, person_id;\nselect company_id, city, sum(budget) from company group by rollup (city, company_id) order by city nulls last, company_id nulls last;\nselect city, count(*) from company group by cube (city) order by 1 nulls first;\nselect venue_code, extract(year from perf_date) as y, count(*) from performance group by grouping sets ((venue_code), (extract(year from perf_date)), ()) order by 1 nulls last, 2 nulls last;\nselect venue_code, extract(year from perf_date) as y, grouping(venue_code, extract(year from perf_date)), count(*) from performance group by rollup (venue_code, extract(year from perf_date)) order by 1 nulls last, 2 nulls last;\nselect count(*) filter (where fee > 1200), count(*) from artist;\nselect company_id, array_agg(person_id order by person_id) from artist group by company_id order by 1;\nselect percentile_cont(0.5) within group (order by fee), percentile_disc(0.5) within group (order by fee), mode() within group (order by genre) from artist, production where artist.company_id = production.company_id;\nselect stddev(fee)::numeric(12,4), variance(budget)::numeric(24,2) from artist, company where artist.company_id = company.company_id;\nselect bool_and(fee > 100), bool_or(fee > 2500), every(company_id is not null) from artist;\nselect json_agg(name order by name) from company where city = (select min(city) from company);\nselect jsonb_build_object('who', billed_as, 'fee', fee) from artist where company_id = 'C01' order by person_id;\nselect * from generate_series(1, 5) as g(x) where x % 2 = 1;\nselect x, y from generate_series(1, 3) x, generate_series(x, 3) y order by 1, 2;\nselect c.company_id, top.person_id from company c, lateral (select person_id from artist a where a.company_id = c.company_id order by fee desc, person_id limit 1) top order by 1;\nselect c.company_id, top.person_id from company c left join lateral (select person_id from artist a where a.company_id = c.company_id and fee > 1800 order by fee desc, person_id limit 1) top on true order by 1;\nselect unnest(array[1,2,3]);\nselect * from unnest(array['a','b'], array[1,2,3]) as t(l, n) order by n;\nselect * from unnest(array[10, 20]) with ordinality;\nselect prod_id, title from production where title similar to '%(Salt|Ferryman)%' order by 1;\nselect title from production where title ~ '^[A-C]' order by 1;\nselect company_id from company where budget > (select avg(budget) from company) and city in (select city from venue where opened > 1950) order by 1;\nselect a.person_id, (select count(*) from casting c where c.person_id = a.person_id) as n from artist a order by n desc, person_id limit 8;\nselect person_id from artist a where exists (select 1 from casting c join performance f using (prod_id) where c.person_id = a.person_id and f.venue_code = (select min(venue_code) from venue)) order by 1;\nselect person_id from artist a where not exists (select 1 from casting c where c.person_id = a.person_id) order by 1;\nselect p.name, count(b.perf_id) from patron p left join booking b on p.patron_id = b.patron_id group by p.patron_id, p.name having count(b.perf_id) > 8 order by 2 desc, 1;\nselect patron.patron_id, patron.name from patron where points > all (select points from patron where city = (select min(city) from patron)) order by 1;\nselect array(select person_id from artist where company_id = 'C02' order by person_id);\nselect company_id, count(*) as n from artist group by company_id having count(*) = (select max(c) from (select count(*) as c from artist group by company_id) x) order by 1;\nselect (select count(*) from booking where booking.patron_id = p.patron_id and rating = 5) as top_count, p.name from patron p order by top_count desc, p.name, p.patron_id limit 5;\nselect perf_id, count(*) from booking group by perf_id having count(*) > (select avg(c) from (select count(*) as c from booking group by perf_id) y) order by 2 desc, 1 limit 10;\nselect title, runtime_min from production p1 where runtime_min = (select max(runtime_min) from production p2 where p2.company_id = p1.company_id) order by 1;\nselect 10 / 3, 10 % 3, 10.0 / 3, -7 / 2, -7 % 2, 2 ^ 10, 7::float / 2;\nselect 1 / 0;\nselect 'abc' || 'def', 'x' || 1 || null;\nselect cast('2024-03-15' as date) + 30, date '2024-03-01' - date '2024-02-01', interval '1 day' * 3;\nselect timestamp '2024-01-31 10:00' + interval '1 month', extract(year from date '2023-07-04'), date_trunc('month', timestamp '2024-05-17 13:45');\nselect length('database'), substring('database' from 5 for 4), position('base' in 'database'), trim('  x  '), lower('ABC'), upper('abc');\nselect round(123.456, 1), round(2.5), round(-2.5), trunc(9.99), ceil(1.1), floor(-1.1), abs(-3), mod(10, 4);\nselect 2147483647 + 1;\nselect '12'::int + 1, '3.5'::numeric * 2, 'true'::boolean, '1'::bigint;\nselect 'abc'::int;\nselect array[1,2,3] || 4, array[1,2] = array[1,2], 2 = any(array[1,2,3]), (array[[1,2],[3,4]])[2][1];\nselect '{\"a\": {\"b\": [1, 2, 3]}}'::jsonb -> 'a' -> 'b' -> 1, '{\"a\": 1}'::jsonb ->> 'a', '{\"a\":1,\"b\":2}'::jsonb @> '{\"a\":1}';\nselect row(1, 'a') = row(1, 'a'), (1, 2) < (1, 3), (1, null) = (1, 2);\nselect person_id from artist where (company_id, fee) in (select company_id, max(fee) from artist group by company_id) order by 1;\nselect case when count(*) > 10 then 'many' else 'few' end from booking where rating = 1;\nselect count(*) from (select distinct prod_id, venue_code from performance) x;\nselect count(*) from booking b1 join booking b2 on b1.perf_id = b2.perf_id and b1.patron_id < b2.patron_id;\nselect company_id, sum(runtime_min) from production group by company